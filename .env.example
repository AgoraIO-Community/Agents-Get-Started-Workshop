# Write the Agora-managed values with:
# agora project env write .env.local --project Testing --template standard
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Overrides the committed development password AgoraWorkshop2026.
WORKSHOP_HOST_KEY=

# Connect a PRIVATE Vercel Blob store to this project.
# Pull its token for local development with: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
